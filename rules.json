{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || ($uid === 'KFSg3IGNBVfrblI8NGncLio1mEI2' && auth.uid === 'KFSg3IGNBVfrblI8NGncLio1mEI2' && auth.token.email === 'ds5ezp@gmail.com' && !root.child('admins').exists()))"
      }
    },
    "vehicles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true"
    },
    "driverAnnouncements": {
      "$vehicle": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || root.child('vehicles').child($vehicle).child('uid').val() === auth.uid)",
        "$announcementId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true"
        }
      }
    },
    "driverAnnouncementRegistry": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "$announcementId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true"
      }
    },
    "urgentNotice": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true"
    },
    "publicLiveStatus": {
      ".read": true,
      "$course": {
        "$round": {
          "busPosition": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || (root.child('vehicles').child(newData.child('busNumber').val()).child('uid').val() === auth.uid && root.child('vehicles').child(newData.child('busNumber').val()).child('allowedCourses').child($course).val() === true))"
          },
          "stationLogs": {
            "$stopKey": {
              ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || (root.child('vehicles').child(root.child('publicLiveStatus').child($course).child($round).child('busPosition').child('busNumber').val()).child('uid').val() === auth.uid && root.child('vehicles').child(root.child('publicLiveStatus').child($course).child($round).child('busPosition').child('busNumber').val()).child('allowedCourses').child($course).val() === true))"
            }
          },
          "etaStats": {
            "$segment": {
              "$hour": {
                ".write": "auth != null && root.child('vehicles').child(root.child('publicLiveStatus').child($course).child($round).child('busPosition').child('busNumber').val()).child('uid').val() === auth.uid && root.child('vehicles').child(root.child('publicLiveStatus').child($course).child($round).child('busPosition').child('busNumber').val()).child('allowedCourses').child($course).val() === true"
              }
            }
          }
        }
      }
    },
    "liveBuses": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "$course": {
        "$round": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || (newData.child('uid').val() === auth.uid && root.child('vehicles').child(newData.child('busNumber').val()).child('uid').val() === auth.uid && root.child('vehicles').child(newData.child('busNumber').val()).child('allowedCourses').child($course).val() === true))"
        }
      }
    },
    "stationLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "$date": {
        "$course": {
          "$round": {
            "$stopKey": {
              ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || (newData.child('uid').val() === auth.uid && root.child('vehicles').child(newData.child('busNumber').val()).child('uid').val() === auth.uid && root.child('vehicles').child(newData.child('busNumber').val()).child('allowedCourses').child($course).val() === true && (!data.exists() || data.child('uid').val() === auth.uid)))"
            }
          }
        }
      }
    },
    "traceLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "$date": {
        "$vehicle": {
          "$traceKey": {
            "$pushId": {
              ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || (root.child('vehicles').child($vehicle).child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid))"
            }
          }
        }
      }
    },
    "driverTripLogs": {
      "$vehicle": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || root.child('vehicles').child($vehicle).child('uid').val() === auth.uid)",
        ".indexOn": ["endedAtMs"],
        "$logId": {
          ".write": "auth != null && root.child('vehicles').child($vehicle).child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid && newData.child('vehicle').val() === $vehicle"
        }
      }
    }
  }
}